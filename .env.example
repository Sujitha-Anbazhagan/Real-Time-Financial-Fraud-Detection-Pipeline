# Kafka Configuration
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=fraud_detection
KAFKA_GROUP_ID=fraud_detection_group

# Cassandra Configuration
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fraud_detection

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Model Configuration
MODEL_THRESHOLD=0.5
BATCH_SIZE=32

# Logging
LOG_LEVEL=INFO

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_MEMORY=4g
